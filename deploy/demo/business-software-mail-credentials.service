# Refreshes the api's mail-only credentials (deploy/demo/mail-credentials.sh, ADR 0040's
# 2026-11-20 note). Started by business-software-mail-credentials.timer; start.sh also runs the
# script once before the stack starts. Installed by install.sh into /etc/systemd/system.
[Unit]
Description=Business Software mail credentials for the api
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/opt/business-software/mail-credentials.sh
