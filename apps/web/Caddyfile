# Serves the web app and passes /api to the api container, so the browser sees one
# origin: session cookies work and there's no CORS (ADR 0011).
{
	# No admin API and no config written to disk: this file is the whole config.
	admin off
	persist_config off
	# HTTP/1.1 and HTTP/2 only. HTTP/3 needs UDP 443, which the server's firewall doesn't
	# open, so advertising it would only make browsers try and wait.
	servers {
		protocols h1 h2
	}
}

(security_headers) {
	header {
		# The app loads nothing from other sites, so the browser refuses anything that
		# isn't ours, including injected scripts.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
	# HSTS: once a browser has seen this over HTTPS, it uses only HTTPS for this name for a
	# year, even if someone types http:// or a network tries to downgrade it. Only on HTTPS
	# responses: over plain HTTP the header means nothing (browsers ignore it there).
	# @https is defined once in the site below: handle_errors shares the site's matchers,
	# so defining it here would define it twice.
	header @https Strict-Transport-Security "max-age=31536000"
}

# Locally and in CI there's no SITE_ADDRESS: plain HTTP on :8080 inside Docker. On the
# server it is the DuckDNS name (deploy/demo/compose.yaml). Caddy then gets and renews a
# Let's Encrypt certificate itself, serves HTTPS on 443 and redirects port 80 to it
# ("automatic HTTPS" switches on only for a site with a host name).
{$SITE_ADDRESS::8080} {
	@https protocol https
	encode zstd gzip
	import security_headers

	# /api itself too, so a call to the bare prefix reaches the API instead of the app's HTML.
	@api path /api /api/*
	handle @api {
		reverse_proxy api:3000
	}

	# Vite puts a hash of the content in these names, so a changed file gets a new name
	# and the old one can be cached forever. A missing one is a plain 404, never index.html:
	# an old tab asking for a deleted file must not cache HTML for a year.
	handle /assets/* {
		root * /srv
		@exists file
		header @exists Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Every other path is a page of the app: send index.html and let the router decide.
	# no-cache: the browser checks for a new deploy on every load.
	handle {
		root * /srv
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server
	}

	# Errors (a missing asset, the api down) start a fresh response, which drops the
	# headers set above, so set them again; and never let a browser keep an error.
	handle_errors {
		import security_headers
		header Cache-Control no-store
		respond "{err.status_code} {err.status_text}"
	}
}
