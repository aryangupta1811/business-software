# Every 20 minutes. Each refresh lasts 1 hour, so the file always has 40 minutes or more left,
# and one failed refresh (a network blip) is covered by the next two.
[Unit]
Description=Refresh the api's mail credentials every 20 minutes

[Timer]
OnActiveSec=20min
OnUnitActiveSec=20min

[Install]
WantedBy=timers.target
