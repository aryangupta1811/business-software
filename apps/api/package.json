{
  "name": "@business-software/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "seed:demo": "node --env-file-if-exists=../../.env dist/demo/seed-cli.js",
    "dev": "tsc -b tsconfig.build.json && pnpm run --parallel \"/^dev:/\"",
    "dev:build": "tsc -b tsconfig.build.json -w --preserveWatchOutput",
    "dev:run": "node --watch --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@aws-sdk/client-sesv2": "^3.1171.0",
    "@business-software/db": "workspace:*",
    "@business-software/shared": "workspace:*",
    "@nestjs/common": "^12.5.0",
    "@nestjs/core": "^12.5.0",
    "@nestjs/platform-express": "^12.5.0",
    "nodemailer": "^10.6.0",
    "pg-boss": "^12.38.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@types/nodemailer": "^8.0.2",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
