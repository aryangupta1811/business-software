# Copy to terraform.tfvars (git-ignored) and put in the real 12-digit account ID.
allowed_account_ids = ["123456789012"]

# The demo's email sender (mail.tf). AWS emails it a verification link at the first apply.
mail_from = "sender@example.com"
# Optional: more addresses that may receive demo email while SES is in its sandbox.
# mail_recipients = ["someone@example.com"]
