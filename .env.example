# Copy to .env (git-ignored) and replace every change-me value.
# Use letters and digits only: the passwords also go inside URLs.

# PostgreSQL administrator (only for the one-time role setup)
POSTGRES_PASSWORD=change-me-admin
# Migration role: owns the schema
APP_OWNER_PASSWORD=change-me-owner
# Runtime role: what the app logs in as
APP_RUNTIME_PASSWORD=change-me-runtime
# Queue role: what the worker's job queue (pg-boss) logs in as; owns only schema pgboss
APP_QUEUE_PASSWORD=change-me-queue

MIGRATION_DATABASE_URL=postgresql://app_owner:change-me-owner@127.0.0.1:5432/business_software
# What the api and worker log in as (the runtime role, never the owner)
DATABASE_URL=postgresql://app_runtime:change-me-runtime@127.0.0.1:5432/business_software
# What only the worker's job queue logs in as (ADR 0022); the api never reads it
QUEUE_DATABASE_URL=postgresql://app_queue:change-me-queue@127.0.0.1:5432/business_software

# Login cookies are Secure with __Host- names (ADR 0038). Chrome accepts them on
# http://127.0.0.1, so leave this unset; false only for a browser that refuses them.
# COOKIE_SECURE=false

# Email (ADR 0040). On this computer it goes to Mailpit, which `pnpm db:up` starts; read it
# at http://127.0.0.1:8025. Unset MAIL_TRANSPORT (or none) sends nothing and logs that.
# The server uses MAIL_TRANSPORT=ses with its instance role: no AWS keys in any file.
MAIL_TRANSPORT=smtp
SMTP_URL=smtp://127.0.0.1:1025
MAIL_FROM=no-reply@example.test
# The web app's address: every emailed link starts with it.
APP_URL=http://127.0.0.1:5173
# The demo's SES sandbox reaches verified addresses only (Module 00 #45).
# EMAIL_LIMITED=true
# Make this server the public demo: the login page offers "Try as the owner" and "Try as a cashier",
# and `pnpm seed:demo` may run (docs/devops/demo-data.md). Off everywhere but the demo server.
# DEMO_ENABLED=true
