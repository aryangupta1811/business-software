# Copy to .env (git-ignored) and replace every change-me value.
# Use letters and digits only: the passwords also go inside URLs.

# PostgreSQL administrator (only for the one-time role setup)
POSTGRES_PASSWORD=change-me-admin
# Migration role: owns the schema
APP_OWNER_PASSWORD=change-me-owner
# Runtime role: what the app logs in as
APP_RUNTIME_PASSWORD=change-me-runtime

MIGRATION_DATABASE_URL=postgresql://app_owner:change-me-owner@127.0.0.1:5432/business_software
# What the api and worker log in as (the runtime role, never the owner)
DATABASE_URL=postgresql://app_runtime:change-me-runtime@127.0.0.1:5432/business_software
